*{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body{
            background: #f5f5f5;
            max-width: 1200px;
            margin: auto;
        }

        .menu{
            width: 100%;
            background: #d7b78a;
            padding: 18px 0;
        }

        .menu ul{
            list-style-type: none;
            display: flex;
            justify-content: center;
            gap: 60px;
        }

        .menu ul li a{
            text-decoration: none;
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 18px;
            transition: 0.3s;
        }

        .menu ul li a:hover{
            color: red;
        }

        /* TITLE */
        .title{
            font-size: 32px;
            margin: 30px;
            color: #222;
        }

        /* PRODUCT */
        .product-list{
            width: 95%;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 25px;
        }

        .product{
            background: white;
            border: 1px solid #ff5a7a;
            position: relative;
            overflow: hidden;
            transition: 0.3s;
        }

        .product:hover{
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* SALE */
        .sale{
            position: absolute;
            top: 15px;
            left: 15px;
            width: 50px;
            height: 50px;
            background: red;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            z-index: 2;
        }

        .product img{
            width: 100%;
            height: 420px;
            object-fit: contain;
            background: #eee;
            padding: 30px;
        }

        .info{
            text-align: center;
            padding: 20px;
        }

        .info h3{
            margin-bottom: 10px;
            font-size: 30px;
        }

        .old-price{
            color: red;
            text-decoration: line-through;
            font-size: 28px;
        }

        .new-price{
            color: red;
            font-size: 32px;
            font-weight: bold;
            margin-left: 8px;
        }

        .btn{
            margin-top: 15px;
            display: inline-block;
            padding: 12px 22px;
            background: red;
            color: white;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }
